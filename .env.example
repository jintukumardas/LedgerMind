# Blockchain Configuration
SEI_RPC_HTTP=https://evm-rpc-testnet.sei-apis.com
SEI_CHAIN_ID=1328
SEI_MAINNET_RPC=https://evm-rpc.sei-apis.com
SEI_MAINNET_CHAIN_ID=1329

# Private keys. This file is a template; the real .env is gitignored.
# Testnet keys only. Never pass these as --env flags or CLI arguments -
# they end up in shell history and in MCP client config files.
PRIVATE_KEY_DEPLOYER=
PRIVATE_KEY_PAYER=
PRIVATE_KEY_AGENT=

# Contract Addresses
FACTORY_ADDRESS=0xfF0e7F71a0e19E0BF037Bd90Ba30A2Ee409E53a7
USDC_ADDRESS=0x4fCF1784B31630811181f670Aea7A7bEF803eaED

# IPFS Configuration
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_API_KEY=
IPFS_API_SECRET=

# GOAT SDK Configuration
GOAT_API_KEY=

# The Graph (primary data source since ETHOnline 2026)
# Query URL and API key from https://thegraph.com/studio/
SUBGRAPH_URL=
GRAPH_API_KEY=

# Required by /api/v1/analyze
ANTHROPIC_API_KEY=

# Legacy PostgreSQL indexer. Superseded by the subgraph and no longer read by
# any judged code path - see packages/subgraph/README.md.
DATABASE_URL=postgresql://localhost:5432/ledgermind

# API Configuration
PORT=3050
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_CHAIN_ID=1328
NEXT_PUBLIC_RPC_URL=https://evm-rpc-testnet.sei-apis.com
NEXT_PUBLIC_FACTORY_ADDRESS=0xfF0e7F71a0e19E0BF037Bd90Ba30A2Ee409E53a7
NEXT_PUBLIC_USDC_ADDRESS=0x4fCF1784B31630811181f670Aea7A7bEF803eaED

# NEXT_PUBLIC_AGENT_PRIVATE_KEY - deliberately left unset.
#
# The NEXT_PUBLIC_ prefix inlines a value into the client bundle, so anyone
# loading the page can read the signing key. It is still read by
# apps/web/src/lib/agent-wallet.ts (used only by the agent-demo component);
# left unset, that module falls back to a throwaway random key and logs a
# warning, which is the safe behaviour. Do not set it.
#
# Properly fixing this means moving agent signing server-side. Not done
# during ETHOnline 2026 - see AI_USAGE.md.
